# Copy to .env and fill in. Never commit .env.

# Sarvam, one key covers chat, speech to text and text to speech.
# Auth header is api-subscription-key. Auth failures come back as 403, not 401.
SARVAM_API_KEY=

# Chat model id. Sarvam-M is deprecated and removed, sarvam-105b is the flagship.
# sarvam-105b-conversations is the variant tuned for voice agents.
SARVAM_LLM_MODEL=sarvam-105b

# live   always call Sarvam
# record use the cache when warm, otherwise call and save the answer (default)
# replay cached answers only, no network at all. Demo day insurance.
LLM_MODE=record

# Voice agent, filled in once the agent and the number exist.
SARVAM_AGENT_ID=
SARVAM_PHONE_NUMBER=
DEMO_PHONE=
VOICE_MODE=local
